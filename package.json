{
  "name": "dem-tiles",
  "version": "3.0.0",
  "description": "Decode elevation from Terrain RGB and Terrarium raster tilesets by longitude and latitude. Fork of @watergis/terrain-rgb.",
  "type": "module",
  "main": "dist/dem-tiles.umd.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/dem-tiles.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dem-tiles.es.js",
      "require": "./dist/dem-tiles.umd.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "prepare": "npm run build",
    "build:cjs": "tsc --project . --module commonjs --outDir ./dist",
    "build:esm": "tsc --project . --module es2015 --outDir ./es6",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "release": "changeset publish",
    "typedoc": "typedoc --entryPointStrategy Expand src/lib --out docs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project \"browser*\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrico88/dem-tiles.git"
  },
  "author": {
    "name": "Jin IGARASHI"
  },
  "contributors": [
    {
      "name": "alrico88"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alrico88/dem-tiles/issues"
  },
  "homepage": "https://github.com/alrico88/dem-tiles#readme",
  "funding": {
    "type": "individual",
    "url": "https://github.com/watergis/terrain-rgb"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.20.0",
    "@mapbox/sphericalmercator": "^2.0.2",
    "@mapbox/tilebelt": "^2.0.3",
    "@types/buffer-from": "^1.1.3",
    "@types/node": "^22.13.1",
    "@types/pako": "^2.0.3",
    "@types/png-chunks-encode": "^1.0.2",
    "@types/png-chunks-extract": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitest/browser-playwright": "5.0.3",
    "canvas": "^3.1.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-png": "^8.0.0",
    "globals": "^15.14.0",
    "lefthook": "^1.10.10",
    "lru-cache": "^11.3.5",
    "math-helper-functions": "^4.0.0",
    "p-memoize": "^8.0.0",
    "playwright": "^1.64.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "prettier": "^3.5.0",
    "publint": "^0.3.4",
    "string-object-formatter": "^4.0.1",
    "typedoc": "^0.27.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.4.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "pnpm": "^10.0.0",
    "node": "^22.12.0 || >=24.0.0"
  }
}
